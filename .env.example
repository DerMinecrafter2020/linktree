# OpenWeb — Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an.

# App
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# Session
SESSION_SECRET=__SET_ME_MANUALLY__
SESSION_MAX_AGE_MS=86400000

# PostgreSQL
DATABASE_URL=postgresql://openweb:openweb@localhost:5432/openweb
# Alternative: einzelne Werte
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=openweb
# DB_USER=openweb
# DB_PASSWORD=openweb

# Initialer Admin-User (wird nur beim Seeding verwendet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__SET_ME_MANUALLY__

# Navidrome (optional)
# 32-Byte-Hex-Key fuer AES-256-GCM Verschluesselung des Passworts in der DB
# Generiere mit: openssl rand -hex 32
NAVIDROME_ENCRYPTION_KEY=__SET_ME_MANUALLY__
NAVIDROME_URL=
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
NAVIDROME_POLL_INTERVAL_SEC=30
