{
  "name": "openweb",
  "version": "3.0.8",
  "description": "Link-in-Bio Seite mit Node.js, Express und PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/reset.js",
    "version:patch": "sh scripts/bump-version.sh patch",
    "version:minor": "sh scripts/bump-version.sh minor",
    "version:major": "sh scripts/bump-version.sh major",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "echo \"Tests noch nicht konfiguriert\" && exit 0"
  },
  "keywords": [
    "linktree",
    "link-in-bio",
    "navidrome",
    "postgres"
  ],
  "author": "Cornelius Ahner",
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "nodemailer": "^9.1.1",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
